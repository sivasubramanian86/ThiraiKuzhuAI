# ==============================================================================
# Thirai Kuzhu AI — Backend Environment Configuration Template
# ==============================================================================
# In production on Google Cloud Run, DO NOT set static API keys.
# Thirai Kuzhu AI utilizes the Gemini Enterprise Agent Platform via Vertex AI
# with Application Default Credentials (ADC) and Workload Identity Federation (WIF).
# ==============================================================================

GOOGLE_CLOUD_PROJECT=genai-blockbuster-2026
GOOGLE_CLOUD_LOCATION=us-central1
PRIMARY_MODEL=gemini-3.8-flash-001
DIRECTOR_MODEL=gemini-3.8-pro-001
GEMINI_API_KEY=

GRAFANA_URL=https://thiraikuzhu.grafana.net
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp
GRAFANA_TOKEN=glsa_your_grafana_service_account_token_here

APP_NAME=Thirai Kuzhu AI
ENV=development
PORT=8080
LOG_LEVEL=INFO

MAX_MISSION_DURATION_SECONDS=60
MAX_TOOL_CALLS_PER_MISSION=8
MAX_TOKEN_BUDGET=16000

FIREBASE_PROJECT_ID=genai-blockbuster-2026
AUTH_ENABLED=false
KMS_KEY_RING=cinema-keyring-2026
KMS_CRYPTO_KEY=cinema-master-cmek
