# ==============================================================================
# Thirai Kuzhu AI (திரை குழு AI) — Environment Configuration Template
# ==============================================================================
# In production on Google Cloud Run, DO NOT set static API keys.
# Thirai Kuzhu AI utilizes the Gemini Enterprise Agent Platform via Vertex AI
# with Application Default Credentials (ADC) and Workload Identity Federation (WIF).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform & Vertex AI (Gemini Enterprise Agent Platform)
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=genai-blockbuster-2026
GOOGLE_CLOUD_LOCATION=us-central1

# Model Tiers
PRIMARY_MODEL=gemini-3.8-flash-001
DIRECTOR_MODEL=gemini-3.8-pro-001

# NOTE: In Cloud Run, authentication is automatic via the assigned service account:
# thirai-kuzhu-orchestrator-sa@genai-blockbuster-2026.iam.gserviceaccount.com
# GEMINI_API_KEY is ONLY an optional local developer fallback when ADC is not configured.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Grafana Cloud MCP Partner Track
# ------------------------------------------------------------------------------
GRAFANA_URL=https://thiraikuzhu.grafana.net
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp
# In production, GRAFANA_TOKEN is fetched from Google Secret Manager:
# projects/genai-blockbuster-2026/secrets/grafana-cloud-mcp-token/versions/latest
GRAFANA_TOKEN=glsa_your_grafana_service_account_token_here

# ------------------------------------------------------------------------------
# 3. Application Runtime & Governance
# ------------------------------------------------------------------------------
APP_NAME=Thirai Kuzhu AI
ENV=development
PORT=8080
LOG_LEVEL=INFO

# Governance & Denial-of-Wallet Circuit Breakers
MAX_MISSION_DURATION_SECONDS=60
MAX_TOOL_CALLS_PER_MISSION=8
MAX_TOKEN_BUDGET=16000

# ------------------------------------------------------------------------------
# 4. Security & Firebase / Firestore (Optional Enterprise Auth)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=genai-blockbuster-2026
AUTH_ENABLED=false
KMS_KEY_RING=cinema-keyring-2026
KMS_CRYPTO_KEY=cinema-master-cmek
